{
  "name": "glimpse",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A small, finite feed for curiosity and everyday exploration.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "content:publish": "node scripts/publish-content.mjs",
    "test:database": "node --test tests/database.test.mjs",
    "test:build": "npm run build && node --test tests/built-site.mjs",
    "db:login": "supabase login",
    "db:status": "supabase migration list --project-ref cwixbyldslmxemgbjace",
    "db:preview": "supabase db push --project-ref cwixbyldslmxemgbjace --dry-run --skip-vault",
    "db:publish": "supabase db push --project-ref cwixbyldslmxemgbjace --skip-vault"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "esbuild": "^0.25.0",
    "supabase": "2.118.0"
  }
}
